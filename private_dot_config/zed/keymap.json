// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      "alt-t": "terminal_panel::ToggleFocus",
      "alt-f": "project_panel::ToggleFocus",

      // Relative navigation
      "alt-h": "pane::ActivatePreviousItem",
      "alt-l": "pane::ActivateNextItem",
      "alt-x": "pane::CloseActiveItem",

      // Finding things
      "alt-s f": "file_finder::Toggle",
      "alt-s s": "project_symbols::Toggle",
    },
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "alt-f": "project_panel::Toggle",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "alt-t": "terminal_panel::Toggle",
    },
  },
]
